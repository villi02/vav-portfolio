# Copy these into .env.local (local preview) or your host's server environment.
# Never prefix credentials with NEXT_PUBLIC_. Never commit .env.local.
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
# Numeric GA4 property IDs, NOT the G-... measurement IDs.
UTVEKSLING_GA_PROPERTY_ID=
TIMEPLAN_GA_PROPERTY_ID=
UTVEKSLING_GA_START_DATE=2025-01-01
TIMEPLAN_GA_START_DATE=2025-01-01
# Current Timeplan database. Prefer a read-only count endpoint in production.
# A publishable key is sufficient only if SELECT RLS allows the complete count.
TIMEPLAN_SUPABASE_URL=
TIMEPLAN_SUPABASE_KEY=
# Optional overrides for the checked-in public snapshots; integers, no '+' sign.
# Leave commented to use data/project-fallbacks.mjs.
# UTVEKSLING_FALLBACK_VISITORS=1400
# TIMEPLAN_FALLBACK_VISITORS=400
# TIMEPLAN_FALLBACK_SCHEDULES=
